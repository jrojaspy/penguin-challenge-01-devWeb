extends ../layout

block content
  section.hero
    h1 Tienda de los Pingüinos

    p
      | Compra productos desde tu iglú
      | mediante una experiencia completamente
      | renderizada desde el servidor.

  section.catalog(
    aria-labelledby="catalog-title"
  )
    .section-header
      h2#catalog-title Productos

      p
        | Explora los productos disponibles.

    if products.length === 0
      .empty-state
        h3 No hay productos disponibles

        p
          | El catálogo está vacío por el momento.

    else
      .product-grid
        each product in products
          article.product-card
            .product-card-content
              h3= product.name

              p.product-description
                = product.description

              .product-meta
                span.product-price
                  | #{product.price.toLocaleString('es-PY')} Gs.

                if product.stock > 0
                  span.stock.stock-available
                    | Disponible
                else
                  span.stock.stock-empty
                    | Sin stock

              a.button(
                href=`/products/${product._id}`
              ) Ver producto