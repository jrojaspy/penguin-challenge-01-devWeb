doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    )

    title #{title} | Penguin Store

    link(
      rel="stylesheet"
      href="/css/store.css"
    )

  body
    header.store-header
      .container.header-content
        a.brand(
          href="/"
          aria-label="Penguin Store - Inicio"
        ) Penguin Store

        nav(
          aria-label="Navegación principal"
        )
          a(href="/") Productos

    main.container
      block content

    footer.store-footer
      .container
        p
          | Penguin Store — Tienda online de la Antártida