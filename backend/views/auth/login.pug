doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    )

    title Iniciar sesión | Penguin Store Admin

    link(
      rel="stylesheet"
      href="/css/admin.css"
    )

  body.login-page
    main.login-container
      section.login-card(
        aria-labelledby="login-title"
      )
        h1#login-title
          | Penguin Store Admin

        p.login-description
          | Inicia sesión para gestionar
          | productos y pedidos.

        if error
          .validation-errors(
            role="alert"
          )
            p= error

        form(
          action="/login"
          method="POST"
        )
          .form-group
            label(for="username") Usuario

            input(
              type="text"
              id="username"
              name="username"
              value=username
              autocomplete="username"
              required
              autofocus
            )

          .form-group
            label(for="password") Contraseña

            input(
              type="password"
              id="password"
              name="password"
              autocomplete="current-password"
              required
            )

          button.button.button-full(
            type="submit"
          ) Iniciar sesión