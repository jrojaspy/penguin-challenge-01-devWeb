extends ../layout

block content
  section.page-section
    .page-header
      div
        h1 Pedidos

        p
          | Pedidos realizados desde la tienda pública.

    if orders.length === 0
      section.empty-state(
        aria-labelledby="empty-orders-title"
      )
        h2#empty-orders-title
          | No hay pedidos registrados

        p
          | Los pedidos realizados desde la tienda
          | aparecerán aquí.

    else
      .orders-list
        each order in orders
          article.order-card
            header.order-card-header
              div
                h2.order-number
                  | Pedido ##{order._id.toString().slice(-6).toUpperCase()}

                time.order-date(
                  datetime=order.createdAt.toISOString()
                )
                  | #{order.createdAt.toLocaleString('es-PY')}

              if order.status === 'pending'
                span.status.status-pending Pendiente

              else if order.status === 'completed'
                span.status.status-active Completado

              else
                span.status.status-inactive Cancelado

            .order-customer
              dl.order-details
                dt Cliente
                dd= order.customerName

                dt Dirección
                dd= order.address

            section.order-items
              h3 Productos

              .table-wrapper
                table.products-table
                  caption.sr-only
                    | Productos incluidos en el pedido

                  thead
                    tr
                      th(scope="col") Producto
                      th(scope="col") Precio unitario
                      th(scope="col") Cantidad
                      th(scope="col") Subtotal

                  tbody
                    each item in order.items
                      tr
                        td= item.productName

                        td
                          | #{item.unitPrice.toLocaleString('es-PY')} Gs.

                        td= item.quantity

                        td
                          | #{item.subtotal.toLocaleString('es-PY')} Gs.

            footer.order-total
              strong
                | Total: #{order.total.toLocaleString('es-PY')} Gs.