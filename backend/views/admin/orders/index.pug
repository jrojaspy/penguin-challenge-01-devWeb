doctype html
html(lang='es')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title= title
    link(rel='stylesheet', href='/css/admin.css')

  body
    header.admin-header
      div
        h1 Penguin Store
        p Panel de administración

      nav(aria-label='Navegación principal')
        a(href='/admin') Inicio
        a(href='/admin/products') Productos
        a(href='/admin/orders', aria-current='page') Pedidos
        form(method='POST', action='/logout')
          button(type='submit') Cerrar sesión

    main.container
      section.page-header
        div
          h2 Pedidos
          p Consulta los pedidos recibidos y actualiza su estado.

      if error
        p.form-error(role='alert')= error

      if orders.length === 0
        section.empty-state
          h3 No hay pedidos registrados
          p Los pedidos realizados desde la tienda aparecerán aquí.
      else
        .table-wrapper
          table.orders-table
            thead
              tr
                th(scope='col') Fecha
                th(scope='col') Cliente
                th(scope='col') Producto
                th(scope='col') Cantidad
                th(scope='col') Precio
                th(scope='col') Total
                th(scope='col') Dirección
                th(scope='col') Estado
                th(scope='col') Actualizar

            tbody
              each order in orders
                - const firstItem = order.items && order.items.length ? order.items[0] : null
                - const productName = firstItem ? firstItem.productName : (order.productName || 'Producto')
                - const quantity = firstItem ? firstItem.quantity : (order.quantity || 1)
                - const unitPrice = firstItem ? firstItem.unitPrice : (order.unitPrice || 0)

                tr
                  td
                    if order.createdAt
                      time(datetime=order.createdAt.toISOString())= order.createdAt.toLocaleString('es-PY')
                    else
                      | —

                  td= order.customerName || '—'

                  td
                    if order.items && order.items.length > 1
                      strong #{order.items.length} productos
                      br
                      small= productName
                    else
                      = productName

                  td
                    if order.items && order.items.length > 1
                      = order.items.reduce((total, item) => total + item.quantity, 0)
                    else
                      = quantity

                  td #{Number(unitPrice).toLocaleString('es-PY')} Gs.

                  td
                    strong #{Number(order.total || 0).toLocaleString('es-PY')} Gs.

                  td= order.address || '—'

                  td
                    case order.status
                      when 'completed'
                        span.status.status-active Completado
                      when 'cancelled'
                        span.status.status-inactive Cancelado
                      default
                        span.status Pendiente

                  td
                    form(
                      method='POST'
                      action=`/admin/orders/${order._id}/status?_method=PATCH`
                    )
                      label.sr-only(for=`status-${order._id}`) Estado del pedido

                      select(
                        id=`status-${order._id}`
                        name='status'
                        required
                      )
                        each statusOption in allowedStatuses
                          option(
                            value=statusOption
                            selected=order.status === statusOption
                          )= statusLabels[statusOption]

                      button.button(type='submit') Guardar
