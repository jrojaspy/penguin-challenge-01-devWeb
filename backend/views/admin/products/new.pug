doctype html
html(lang='es')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title= title
    link(rel='stylesheet', href='/css/admin.css')

  body
    - const activePage = 'products'
    include ../../includes/adminHeader.pug

    main.container
      section.page-header
        div
          p.eyebrow Catálogo
          h1 Nuevo producto
          p Agrega un producto al catálogo de Penguin Store.
        a.button.button-secondary(href='/admin/products') Volver

      if error
        p.form-error(role='alert')= error

      form.product-form(
        method='POST'
        action='/admin/products'
        enctype='multipart/form-data'
      )
        .form-section
          h2 Información del producto

          .form-group
            label(for='name') Nombre
            input(id='name' name='name' type='text' required maxlength='120' value=product.name)

          .form-group
            label(for='description') Descripción
            textarea(id='description' name='description' required maxlength='500' rows='5')= product.description

          .form-grid
            .form-group
              label(for='price') Precio
              input(id='price' name='price' type='number' min='0' step='1' required value=product.price)

            .form-group
              label(for='stock') Stock
              input(id='stock' name='stock' type='number' min='0' step='1' required value=product.stock)

        .form-section
          h2 Imagen y disponibilidad

          .form-group
            label(for='image') Imagen del producto
            input(id='image' name='image' type='file' accept='image/jpeg,image/png,image/webp')
            small Formatos permitidos: JPG, PNG o WebP. Máximo 5 MB.

          .form-check
            input(id='active' name='active' type='checkbox' checked=product.active)
            label(for='active') Producto activo

        .form-actions
          button.button(type='submit') Crear producto
          a.button.button-secondary(href='/admin/products') Cancelar
