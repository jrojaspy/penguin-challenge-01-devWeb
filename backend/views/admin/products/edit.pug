extends ../layout

block content
  section.page-section
    .page-header
      div
        h1 Editar producto

        p
          | Modifica los datos del producto seleccionado.

    if errors && errors.length
      .validation-errors(
        role="alert"
      )
        strong
          | Revisa los siguientes campos:

        ul
          each error in errors
            li= error

    form.product-form(
      action=`/admin/products/${product._id}/edit`
      method="POST"
    )
      .form-group
        label(for="name") Nombre

        input(
          type="text"
          id="name"
          name="name"
          value=product.name
          maxlength="120"
          required
        )

      .form-group
        label(for="description") Descripción

        textarea(
          id="description"
          name="description"
          maxlength="500"
          required
        )= product.description

      .form-row
        .form-group
          label(for="price") Precio en guaraníes

          input(
            type="number"
            id="price"
            name="price"
            value=product.price
            min="0"
            step="1"
            inputmode="numeric"
            required
          )

        .form-group
          label(for="stock") Stock

          input(
            type="number"
            id="stock"
            name="stock"
            value=product.stock
            min="0"
            step="1"
            inputmode="numeric"
            required
          )

      .form-group.checkbox-group
        input(
          type="checkbox"
          id="active"
          name="active"
          checked=product.active
        )

        label(for="active")
          | Producto activo

      .form-actions
        button.button(
          type="submit"
        ) Guardar cambios

        a.button.button-secondary(
          href="/admin/products"
        ) Cancelar