extends ../layout

block content
  section.page-section
    .page-header
      div
        h1 Productos

        p
          | Gestiona los productos disponibles
          | en Penguin Store.

      a.button(
        href="/admin/products/new"
      ) Nuevo producto

    if products.length === 0
      section.empty-state(
        aria-labelledby="empty-products-title"
      )
        h2#empty-products-title
          | No hay productos registrados

        p
          | El catálogo todavía está vacío.

        a.button(
          href="/admin/products/new"
        ) Crear primer producto

    else
      .table-wrapper
        table.products-table
          caption.sr-only
            | Listado de productos

          thead
            tr
              th(scope="col") Nombre
              th(scope="col") Precio
              th(scope="col") Stock
              th(scope="col") Estado
              th(scope="col") Acciones

          tbody
            each product in products
              tr
                td
                  strong= product.name

                  if product.description
                    p.product-description
                      = product.description

                td
                  | #{product.price.toLocaleString('es-PY')} Gs.

                td= product.stock

                td
                  if product.active
                    span.status.status-active Activo
                  else
                    span.status.status-inactive Inactivo

                td
                  .actions
                    a.button.button-small(
                      href=`/admin/products/${product._id}/edit`
                    ) Editar

                    form(
                      action=`/admin/products/${product._id}/delete`
                      method="POST"
                    )
                      button.button.button-danger.button-small(
                        type="submit"
                      ) Eliminar