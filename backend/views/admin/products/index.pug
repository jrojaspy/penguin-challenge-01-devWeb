doctype html
html(lang='es')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title= title
    link(rel='stylesheet', href='/css/admin.css')

  body
    - const activePage = 'products'
    include ../../includes/adminHeader.pug

    main.container
      section.page-header
        div
          p.eyebrow Catálogo
          h1 Productos
          p Gestiona los productos disponibles en la tienda.

        a.button(href='/admin/products/new') Nuevo producto

      if products.length === 0
        section.empty-state
          .empty-state__icon(aria-hidden='true') 🐟
          h2 No hay productos registrados
          p Crea el primer producto para comenzar a cargar el catálogo.
          a.button(href='/admin/products/new') Crear producto
      else
        .table-wrapper(tabindex='0', aria-label='Tabla de productos')
          table.products-table
            thead
              tr
                th(scope='col') Imagen
                th(scope='col') Nombre
                th(scope='col') Precio
                th(scope='col') Stock
                th(scope='col') Estado
                th(scope='col') Acciones
            tbody
              each product in products
                tr
                  td
                    if product.image
                      img.admin-product-thumb(
                        src=product.image
                        alt=`Imagen de ${product.name}`
                        width='72'
                        height='72'
                        loading='lazy'
                      )
                    else
                      .admin-product-placeholder(aria-hidden='true') 🐟

                  td
                    strong= product.name
                  td #{product.price.toLocaleString('es-PY')} Gs.
                  td= product.stock
                  td
                    if product.active
                      span.status.status-active Activo
                    else
                      span.status.status-inactive Inactivo
                  td.actions
                    a.button.button-secondary(href=`/admin/products/${product._id}/edit`) Editar
                    form(method='POST' action=`/admin/products/${product._id}?_method=DELETE`)
                      button.button.button-danger(type='submit') Eliminar
