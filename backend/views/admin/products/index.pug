doctype html
html(lang='es')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title= title
    link(rel='stylesheet', href='/css/admin.css')

  body
    header.admin-header
      div
        h1 Penguin Store
        p Panel de administración

      nav(aria-label='Navegación principal')
        a(href='/admin') Inicio
        a(href='/admin/products', aria-current='page') Productos
        a(href='/admin/orders') Pedidos
        form(method='POST', action='/logout')
          button(type='submit') Cerrar sesión

    main.container
      section.page-header
        div
          h2 Productos
          p Gestiona el catálogo disponible en la tienda.

        a.button(href='/admin/products/new') Nuevo producto

      if products.length === 0
        section.empty-state
          h3 No hay productos registrados
          p Crea el primer producto para comenzar a cargar el catálogo.
          a.button(href='/admin/products/new') Crear producto
      else
        .table-wrapper
          table.products-table
            thead
              tr
                th(scope='col') Imagen
                th(scope='col') Nombre
                th(scope='col') Precio
                th(scope='col') Stock
                th(scope='col') Estado
                th(scope='col') Acciones

            tbody
              each product in products
                tr
                  td
                    if product.image
                      img(
                        src=product.image
                        alt=`Imagen de ${product.name}`
                        width='72'
                        height='72'
                        loading='lazy'
                        style='object-fit: cover; border-radius: 10px;'
                      )
                    else
                      span Sin imagen

                  td= product.name
                  td #{product.price.toLocaleString('es-PY')} Gs.
                  td= product.stock
                  td
                    if product.active
                      span.status.status-active Activo
                    else
                      span.status.status-inactive Inactivo

                  td.actions
                    a.button.button-secondary(
                      href=`/admin/products/${product._id}/edit`
                    ) Editar

                    form(
                      method='POST'
                      action=`/admin/products/${product._id}?_method=DELETE`
                    )
                      button.button.button-danger(type='submit') Eliminar
