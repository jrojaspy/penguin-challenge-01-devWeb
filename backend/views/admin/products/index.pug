doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title

    link(rel="stylesheet" href="/css/admin.css")

  body
    header.admin-header
      h1 Penguin Store Admin

      nav
        a(href="/admin") Inicio
        a(href="/admin/products") Productos
        a(href="/admin/orders") Pedidos

        form.logout-form(
          action="/logout"
          method="POST"
        )
          button.logout-button(
            type="submit"
          ) Cerrar sesión

    main.container
      .page-header
        div
          h2 Productos
          p Gestión del catálogo de Penguin Store.

        a.button(href="/admin/products/new") Nuevo producto

      if products.length === 0
        section.empty-state
          h3 No hay productos registrados

          p El catálogo todavía está vacío.

          a.button(href="/admin/products/new") Crear primer producto

      else
        .table-wrapper
          table.products-table
            thead
              tr
                th Nombre
                th Precio
                th Stock
                th Estado
                th Acciones

            tbody
              each product in products
                tr
                  td
                    strong= product.name

                    if product.description
                      .product-description= product.description

                  td= `${product.price.toLocaleString('es-PY')} Gs.`

                  td= product.stock

                  td
                    if product.active
                      span.status.status-active Activo
                    else
                      span.status.status-inactive Inactivo

                  td.actions
                    a.button.button-small(
                      href=`/admin/products/${product._id}/edit`
                    ) Editar

                    form(
                      action=`/admin/products/${product._id}/delete`
                      method="POST"
                    )
                      button.button.button-danger.button-small(
                        type="submit"
                      ) Eliminar