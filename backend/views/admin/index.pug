doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")

    title= title

    link(rel="stylesheet" href="/css/admin.css")

  body
    header.admin-header
      div
        h1 Penguin Store Admin

        if currentUser
          small Usuario: #{currentUser.username}

    nav
      a(href="/admin") Inicio
      a(href="/admin/products") Productos
      a(href="/admin/orders") Pedidos

      form.logout-form(
        action="/logout"
        method="POST"
      )
        button.logout-button(
          type="submit"
        ) Cerrar sesión

    main.container
      h2 Panel administrativo

      p Bienvenida al panel de gestión de Penguin Store.

    .dashboard-actions
      a.button(href="/admin/products")
        | Gestionar productos

      a.button(href="/admin/orders")
        | Ver pedidos