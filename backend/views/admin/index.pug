doctype html
html(lang='es')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title= title
    link(rel='stylesheet', href='/css/admin.css')

  body
    - const activePage = 'home'
    include ../includes/adminHeader.pug

    main.container
      section.page-header
        div
          p.eyebrow Administración
          h1 Panel principal
          p Gestiona el catálogo y los pedidos de Penguin Store.

      section.admin-dashboard(aria-label='Módulos administrativos')
        article.dashboard-card
          .dashboard-card__icon(aria-hidden='true') 🐟
          h2 Productos
          p Gestiona productos, imágenes, precios, stock y disponibilidad.
          a.button(href='/admin/products') Gestionar productos

        article.dashboard-card
          .dashboard-card__icon(aria-hidden='true') 📦
          h2 Pedidos
          p Consulta los pedidos recibidos y actualiza su estado.
          a.button(href='/admin/orders') Gestionar pedidos
