extends layout

block content
  section.dashboard-hero
    h1 Panel administrativo

    p
      | Gestiona productos y revisa los pedidos
      | realizados desde la tienda pública.

  section.dashboard-actions(
    aria-label="Acciones principales"
  )
    a.dashboard-card(
      href="/admin/products"
    )
      span.dashboard-card-title Productos

      span.dashboard-card-description
        | Crear, editar y eliminar productos del catálogo.

    a.dashboard-card(
      href="/admin/orders"
    )
      span.dashboard-card-title Pedidos

      span.dashboard-card-description
        | Revisar los pedidos recibidos desde la tienda.